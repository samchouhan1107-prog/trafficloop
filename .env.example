# TrafficLoop Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/trafficloop.sqlite

# Authentication
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=your-secure-random-secret-here

# Google Analytics 4 (Optional)
# Get from GA4 Property Settings > Data Streams
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret

# Application URL
APP_URL=http://localhost:3000

# Security Notes:
# - Never commit .env file to version control
# - Use strong, unique secrets for production
# - Rotate secrets periodically
# - Keep API keys and secrets out of client-side code
